rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // System configuration (rewards config, platform settings)
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles & loyalty subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Devotees & Acharyas cannot unilaterally self-assign admin role on registration
      allow create: if isOwner(userId) && isValidId(userId) &&
        (request.resource.data.role != 'admin' || isAdmin());
      // Non-admins cannot elevate their existing role to admin
      allow update: if isValidId(userId) && (
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin())) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /rewards/{rewardId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /rewardTransactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Priests Directory & Availability
    match /priests/{priestId} {
      allow read: if true;
      allow create: if (isOwner(priestId) || isAdmin()) && isValidId(priestId);
      allow update: if (isOwner(priestId) || isAdmin()) && isValidId(priestId);
      allow delete: if isAdmin();

      match /availability/{availId} {
        allow read: if true;
        allow create, update, delete: if (isOwner(priestId) || isAdmin()) && isValidId(availId);
      }
    }

    // Ceremony Requests
    match /requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && isValidId(requestId);
      // Devotee/priest can update notes, cancel, or priest can accept/reject; customers cannot unilaterally set status to CONFIRMED
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.customerId == request.auth.uid && (
          // Devotee can cancel, set payment pending, or update customer notes, but cannot unilaterally confirm
          request.resource.data.status != 'CONFIRMED' || resource.data.status == 'CONFIRMED'
        )) ||
        (resource.data.priestId == request.auth.uid)
      ) && isValidId(requestId);
      allow delete: if isAdmin();
    }

    // Confirmed Bookings (Server-authoritative and Admin write, customer/priest read)
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      // Only server/admin can create bookings (preventing client-side payment forgery)
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.customerId == request.auth.uid) && isValidId(bookingId);
      // Status updates restricted to priest (lifecycle updates) or admin
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin()) && isValidId(bookingId);
      allow delete: if isAdmin();

      match /statusHistory/{histId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.priestId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.priestId == request.auth.uid ||
          isAdmin()
        ) && isValidId(histId);
        allow delete: if isAdmin();
      }
    }

    // Payment Orders (Server-authoritative)
    match /paymentOrders/{orderId} {
      // Customer who owns order, assigned priest, or admin can read
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Orders are written by server or verified customer flow
      allow create: if isSignedIn() && (request.resource.data.customerId == request.auth.uid || isAdmin()) && isValidId(orderId);
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin()) && isValidId(orderId);
      allow delete: if isAdmin();
    }

    // Payment Webhook Records (Audit log - strictly admin read, server write)
    match /paymentWebhooks/{webhookId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Support and Help Requests
    match /supportRequests/{requestId} {
      allow get, list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId);
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin()) && isValidId(requestId);
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && isValidId(reviewId);
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin()) && isValidId(reviewId);
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
      // Devotees & Priests can only read their own notifications; Admins can read admin notifications
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isAdmin() && (resource.data.userId == 'admin' || resource.data.targetRole == 'admin'))
      );
      // Valid creation from authenticated actor with strict fields
      allow create: if isSignedIn() && isValidId(notificationId) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.message is string &&
        request.resource.data.read == false;
      // Users can ONLY update their own read state (cannot forge/modify protected notification content)
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notification Preferences
    match /notificationPreferences/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Reports & Anti-Bypass Incidents
    match /reports/{reportId} {
      allow get, list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid && isValidId(reportId);
      allow update, delete: if isAdmin();
    }

    // Recorded Policy Violations
    match /policyViolations/{violationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Priest Policy Acknowledgements
    match /priestPolicyAcks/{ackId} {
      allow read: if isSignedIn() && (ackId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (ackId == request.auth.uid || request.resource.data.priestId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /policyAcknowledgements/{ackId} {
      allow read: if isSignedIn() && (ackId == request.auth.uid || resource.data.priestId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (ackId == request.auth.uid || request.resource.data.priestId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // AI Ceremony Plans - Strict user ownership & privacy
    match /ceremonyPlans/{planId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidId(planId);
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
